# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecg_insight

# Database container values used by docker-compose.production.yml.
POSTGRES_DB=ecg_insight
POSTGRES_USER=ecg_insight
POSTGRES_PASSWORD=replace-with-strong-database-password

# Secret used to sign short-lived JWT access tokens. Use at least 32 random characters.
JWT_SECRET=replace-with-at-least-32-random-characters

# Separate secret used to sign refresh tokens. Use at least 32 random characters.
JWT_REFRESH_SECRET=replace-with-a-different-32-random-character-secret

# Runtime mode. Supported values: development, test, production.
NODE_ENV=development

# Port for the ECG Insight Express API.
PORT=3002

# Frontend origin allowed to send credentialed API requests.
# Use comma-separated HTTPS origins in production.
CLIENT_ORIGIN=http://localhost:8081

# Optional cookie domain for refresh-token cookies. Leave blank for localhost.
COOKIE_DOMAIN=

# Public API base URL used by the Expo frontend.
EXPO_PUBLIC_API_URL=http://localhost:3002/api

# Optional alias for Vite/web tooling. ECG Insight Expo runtime uses EXPO_PUBLIC_API_URL.
VITE_API_URL=http://localhost:3002/api

# Structured logging level: debug, info, warn, or error.
LOG_LEVEL=info

# Optional external exception monitoring DSN.
EXCEPTION_MONITORING_DSN=

# Optional external deep-learning endpoint for ECG analysis (not used by Copilot chat).
AI_MODEL_API_KEY=
AI_MODEL_ENDPOINT=

# Local clinical chat LLM via Ollama (Copilot). No cloud API keys required when Ollama is enabled.
OLLAMA_ENABLED=true
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# Optional explicit OpenAI fallback (disabled by default).
LLM_OPENAI_FALLBACK=false
OPENAI_API_KEY=

# Set true only in CI/automated tests when Ollama is unavailable.
COPILOT_LLM_MOCK=false

# Optional standalone FastAPI AI engine URL used by production health checks.
AI_ENGINE_URL=

# Optional ONNX model path. If omitted, the API checks ai-engine/runs/first-real-ecg-model/model.onnx,
# ai-engine/artifacts/model.onnx, then ai-engine/model.onnx.
AI_ONNX_MODEL_PATH=

# Local or container upload storage path.
STORAGE_PATH=uploads

# Backup automation.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_MS=86400000

# API rate limiting configuration.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

# Set true when running behind a trusted reverse proxy/load balancer.
TRUST_PROXY=false

# --- Social OAuth (optional; blank = provider disabled) ---
OAUTH_CALLBACK_BASE_URL=http://localhost:3002/api
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=

# --- WebAuthn / Passkeys (Face ID / Touch ID / Windows Hello) ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ECG Insight
SMTP_URL=

# Optional SMTP for password-reset email delivery (EmailOutbox always queues).
