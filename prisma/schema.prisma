enum EnterpriseRuleStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum EnterpriseRuleField {
  QT_INTERVAL
  QTC_INTERVAL
  HEART_RATE
  QRS_DURATION
  PR_INTERVAL
  ST_DEVIATION
  ST_ELEVATION
  RISK_SCORE
  CLINICAL_PRIORITY
  PVC_COUNT
  AF_DETECTED
  BBB_DETECTED
}

enum EnterpriseRuleOperator {
  GT
  GTE
  LT
  LTE
  EQ
  NEQ
  CONTAINS
  IS_TRUE
  IS_FALSE
}

enum EnterpriseRuleLogic {
  AND
  OR
}

enum EnterpriseRuleActionType {
  GENERATE_ALERT
  CREATE_RECOMMENDATION
  SCHEDULE_FOLLOW_UP
  NOTIFY_PHYSICIAN
  NOTIFY_ADMIN
  ESCALATE_CASE
  MARK_CRITICAL
  REQUIRE_MANUAL_REVIEW
}

enum EnterpriseRuleExecutionStatus {
  MATCHED
  NOT_MATCHED
  ERROR
}

model ClinicalRule {
  id               String              @id @default(cuid())
  ruleKey          String              @unique
  name             String
  description      String
  category         String
  priority         Int                 @default(100)
  enabled          Boolean             @default(true)
  status           EnterpriseRuleStatus @default(ACTIVE)
  conditionRootLogic EnterpriseRuleLogic @default(AND)
  currentVersion   Int                 @default(1)
  organizationId   String?
  createdById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  createdBy        User?               @relation("AuthoredClinicalRules", fields: [createdById], references: [id], onDelete: SetNull)
  conditions       RuleCondition[]
  actions          RuleAction[]
  versions         RuleVersion[]
  executions       RuleExecution[]

  @@index([category])
  @@index([enabled])
  @@index([status])
  @@index([priority])
  @@index([organizationId])
}

model RuleVersion {
  id            String       @id @default(cuid())
  ruleId        String
  versionNumber Int
  name          String
  description   String
  category      String
  priority      Int
  enabled       Boolean
  status        EnterpriseRuleStatus
  conditionRootLogic EnterpriseRuleLogic
  snapshotJson  Json
  changeNotes   String?
  createdById   String?
  createdAt     DateTime     @default(now())
  rule          ClinicalRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  createdBy     User?        @relation("EnterpriseRuleVersions", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([ruleId, versionNumber])
  @@index([ruleId])
  @@index([createdAt])
}

model RuleCondition {
  id          String                 @id @default(cuid())
  ruleId      String
  groupId     String                 @default("default")
  groupLogic  EnterpriseRuleLogic    @default(AND)
  field       EnterpriseRuleField
  operator    EnterpriseRuleOperator
  threshold   Float?
  stringValue String?
  boolValue   Boolean?
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  rule        ClinicalRule           @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([groupId])
  @@index([field])
}

model RuleAction {
  id         String                   @id @default(cuid())
  ruleId     String
  actionType EnterpriseRuleActionType
  payload    Json?
