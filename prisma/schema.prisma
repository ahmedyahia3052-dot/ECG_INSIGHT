  enterpriseRole   EnterpriseRole?          @relation(fields: [enterpriseRoleId], references: [id], onDelete: SetNull)
  department       Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  branch           OrganizationBranch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([enterpriseRoleId])
  @@index([status])
  @@index([deletedAt])
}

model LoginHistory {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  ipAddress      String?
  userAgent      String?
  deviceId       String?
  success        Boolean       @default(true)
  failureReason  String?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([success])
  @@index([createdAt])
}

model OrganizationNotification {
  id             String                       @id @default(cuid())
  organizationId String
  userId         String?
  category       EnterpriseNotificationCategory
  title          String
  body           String
  read           Boolean                      @default(false)
  metadata       Json?
  createdAt      DateTime                     @default(now())
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([category])
  @@index([read])
  @@index([createdAt])
}

// ─── Sprint 63: Enterprise ECG Longitudinal Timeline & Follow-up Engine ───

enum ECGFollowUpStatus {
  RECOMMENDED
  SCHEDULED
  DUE
  COMPLETED
  OVERDUE
  CANCELLED
}

enum ECGTrendDirection {
  IMPROVING
  WORSENING
  STABLE
  NEW
  RESOLVED
  INDETERMINATE
}

model ECGTimeline {
  id              String              @id @default(cuid())
  patientId       String
  caseId          String              @unique
  organizationId  String?
  branchId        String?
  physicianId     String?
  studyDate       DateTime
  acquisitionDate DateTime
  reportUuid      String?
  diagnosis       String?
  interpretation  String?
  aiConfidence    Float?
  heartRate       Int?
  prInterval      Int?
  qrsDuration     Int?
  qtInterval      Int?
  qtcInterval     Int?
  axis            Float?
  rhythm          String?
  measurements    Json?
  attachments     Json?
  sequenceNumber  Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  patient         Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  case            ECGCase             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  organization    Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branch          OrganizationBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  physician       User?               @relation("ECGTimelinePhysician", fields: [physicianId], references: [id], onDelete: SetNull)
  comparisons     ECGComparisonHistory[] @relation("TimelineComparisons")
  trendSnapshots  ECGTrendSnapshot[]
  followUps       ECGFollowUp[]

  @@index([patientId])
  @@index([caseId])
  @@index([organizationId])
  @@index([branchId])
  @@index([physicianId])
  @@index([studyDate])
  @@index([acquisitionDate])
  @@index([sequenceNumber])
  @@index([createdAt])
}

model ECGFollowUp {
  id             String            @id @default(cuid())
  patientId      String
  caseId         String?
  timelineId     String?
  recommendation String
  summary        String?
  status         ECGFollowUpStatus @default(RECOMMENDED)
  dueDate        DateTime?
  assignedToId   String?
  createdById    String
  completedAt    DateTime?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  case           ECGCase?          @relation(fields: [caseId], references: [id], onDelete: SetNull)
  timeline       ECGTimeline?      @relation(fields: [timelineId], references: [id], onDelete: SetNull)
  assignedTo     User?             @relation("ECGFollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy      User              @relation("ECGFollowUpCreator", fields: [createdById], references: [id])

  @@index([patientId])
  @@index([caseId])
  @@index([timelineId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
}

model ECGComparisonHistory {
  id                   String   @id @default(cuid())
  patientId            String
  currentCaseId        String
  previousCaseId       String
  timelineId           String?
  evaluatedById        String
  measurementDelta     Json
  diagnosisDelta       Json
  interpretationDelta  Json
  confidenceDelta      Json?
  clinicalSignificance String
  trendSummary         Json
  followUpSummary      String?
  createdAt            DateTime @default(now())
  patient              Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  currentCase          ECGCase     @relation("CurrentComparisonCase", fields: [currentCaseId], references: [id], onDelete: Cascade)
  previousCase         ECGCase     @relation("PreviousComparisonCase", fields: [previousCaseId], references: [id], onDelete: Cascade)
  timeline             ECGTimeline? @relation("TimelineComparisons", fields: [timelineId], references: [id], onDelete: SetNull)
  evaluatedBy          User        @relation("ECGComparisonEvaluator", fields: [evaluatedById], references: [id])
  trendSnapshots       ECGTrendSnapshot[]

  @@index([patientId])
  @@index([currentCaseId])
  @@index([previousCaseId])
  @@index([timelineId])
  @@index([evaluatedById])
  @@index([createdAt])
}

model ECGTrendSnapshot {
  id            String            @id @default(cuid())
  patientId     String
  caseId        String?
  timelineId    String?
  comparisonId  String?
  trendType     String
  direction     ECGTrendDirection
  metric        String?
  currentValue  Float?
  previousValue Float?
  delta         Float?
  threshold     Float?
  statement     String
  significance  String?
  metadata      Json?
  capturedAt    DateTime          @default(now())
  patient       Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  case          ECGCase?             @relation(fields: [caseId], references: [id], onDelete: SetNull)
  timeline      ECGTimeline?         @relation(fields: [timelineId], references: [id], onDelete: SetNull)
  comparison    ECGComparisonHistory? @relation(fields: [comparisonId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([caseId])
  @@index([timelineId])
  @@index([comparisonId])
  @@index([trendType])
  @@index([direction])
  @@index([capturedAt])
}

// ─── Sprint 68: Enterprise FHIR / HL7 Interoperability Engine ───

enum InteroperabilityJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  VALIDATION_FAILED
}

enum InteropHl7MessageType {
  ORM
  ORU
  ADT
  MDM
  ACK
}

enum InteroperabilityDirection {
  EXPORT
  IMPORT
}

enum ExternalSystemProtocol {
  FHIR
  HL7
  HYBRID
}

enum InteroperabilityLogLevel {
  INFO
  WARNING
  ERROR
  AUDIT
}

model ExternalOrganization {
  id               String           @id @default(cuid())
  organizationId   String?
  externalId       String           @unique
  name             String
  fhirEndpoint     String?
  hl7Endpoint      String?
  identifierSystem String?
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  externalSystems  ExternalSystem[]
  fhirAudits       FHIRAudit[]

  @@index([organizationId])
  @@index([name])
  @@index([createdAt])
}

model ExternalSystem {
  id                     String                 @id @default(cuid())
  externalOrganizationId String?
  organizationId         String?
  name                   String
  protocol               ExternalSystemProtocol
  baseUrl                String?
  aeTitle                String?
  status                 String                 @default("ACTIVE")
  supportedResources     String[]               @default([])
  supportedHl7Types      InteropHl7MessageType[] @default([])
  metadata               Json?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  externalOrganization   ExternalOrganization?  @relation(fields: [externalOrganizationId], references: [id], onDelete: SetNull)
  organization           Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  fhirExportJobs         FHIRExportJob[]
  fhirImportJobs         FHIRImportJob[]
  hl7Messages            HL7Message[]
  interoperabilityLogs   InteroperabilityLog[]
  fhirAudits             FHIRAudit[]

  @@index([externalOrganizationId])
  @@index([organizationId])
  @@index([protocol])
  @@index([status])
  @@index([createdAt])
}

model FHIRExportJob {
  id               String                    @id @default(cuid())
  caseId           String?
  patientId        String?
  externalSystemId String?
  requestedById    String
  organizationId   String?
  status           InteroperabilityJobStatus @default(QUEUED)
  resourceTypes    String[]                  @default([])
  bundleType       String?
  payloadJson      Json?
  validationErrors Json?
  completedAt      DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  case             ECGCase?                  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  patient          Patient?                  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  externalSystem   ExternalSystem?           @relation(fields: [externalSystemId], references: [id], onDelete: SetNull)
  requestedBy      User                      @relation("FHIRExportRequestedBy", fields: [requestedById], references: [id])
  organization     Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([patientId])
  @@index([externalSystemId])
  @@index([requestedById])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model FHIRImportJob {
  id                 String                    @id @default(cuid())
  caseId             String?
  patientId          String?
  externalSystemId   String?
  requestedById      String
  organizationId     String?
  status             InteroperabilityJobStatus @default(QUEUED)
  sourcePayload      Json
  importedResources  Json?
  validationErrors   Json?
  completedAt        DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  case               ECGCase?                  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  patient            Patient?                  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  externalSystem     ExternalSystem?           @relation(fields: [externalSystemId], references: [id], onDelete: SetNull)
  requestedBy        User                      @relation("FHIRImportRequestedBy", fields: [requestedById], references: [id])
  organization       Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([patientId])
  @@index([externalSystemId])
  @@index([requestedById])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model HL7Message {
  id               String                    @id @default(cuid())
  caseId           String?
  patientId        String?
  externalSystemId String?
  messageType      InteropHl7MessageType
  direction        InteroperabilityDirection
  rawMessage       String
  parsedSegments   Json?
  status           InteroperabilityJobStatus @default(COMPLETED)
  validationErrors Json?
  ackMessage       String?
  createdById      String
  createdAt        DateTime                  @default(now())
  case             ECGCase?                  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  patient          Patient?                  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  externalSystem   ExternalSystem?           @relation(fields: [externalSystemId], references: [id], onDelete: SetNull)
  createdBy        User                      @relation("HL7MessageCreator", fields: [createdById], references: [id])

  @@index([caseId])
  @@index([patientId])
  @@index([externalSystemId])
  @@index([messageType])
  @@index([direction])
  @@index([status])
  @@index([createdAt])
}

model InteroperabilityLog {
  id               String                   @id @default(cuid())
  externalSystemId String?
  caseId           String?
  patientId        String?
  actorId          String
  level            InteroperabilityLogLevel @default(INFO)
  operation        String
  message          String
  metadata         Json?
  validationFailed Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  externalSystem   ExternalSystem?          @relation(fields: [externalSystemId], references: [id], onDelete: SetNull)
  case             ECGCase?                 @relation(fields: [caseId], references: [id], onDelete: SetNull)
  patient          Patient?                 @relation(fields: [patientId], references: [id], onDelete: SetNull)
  actor            User                     @relation("InteropLogActor", fields: [actorId], references: [id])

  @@index([externalSystemId])
  @@index([caseId])
  @@index([patientId])
  @@index([actorId])
  @@index([level])
  @@index([operation])
  @@index([validationFailed])
  @@index([createdAt])
}

model FHIRAudit {
  id                     String                @id @default(cuid())
  externalSystemId       String?
  externalOrganizationId String?
  organizationId         String?
  actorId                String
  action                 String
  resourceType           String?
  resourceId             String?
  caseId                 String?
  patientId              String?
  success                Boolean               @default(true)
  message                String
  metadata               Json?
  createdAt              DateTime              @default(now())
  externalSystem         ExternalSystem?       @relation(fields: [externalSystemId], references: [id], onDelete: SetNull)
  externalOrganization   ExternalOrganization? @relation(fields: [externalOrganizationId], references: [id], onDelete: SetNull)
  organization           Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor                  User                  @relation("FHIRAuditActor", fields: [actorId], references: [id])
  case                   ECGCase?              @relation(fields: [caseId], references: [id], onDelete: SetNull)
  patient                Patient?              @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([externalSystemId])
  @@index([externalOrganizationId])
  @@index([actorId])
  @@index([action])
  @@index([resourceType])
  @@index([caseId])
  @@index([patientId])
  @@index([organizationId])
  @@index([success])
  @@index([createdAt])
}
